# Conditions and Logic in HUMA X

make age = 18

if age is greater than 18 then
    show "Status: Adult"
else if age is equal to 18 then
    show "Status: Just turned 18!"
otherwise
    show "Status: Underage"
end

make has_license = yes
if age is greater than or equal to 18 and has_license is equal to yes then
    show "Eligible to drive: Yes"
otherwise
    show "Eligible to drive: No"
end
